# ==============================
# 운영체제에서 자동 생성되는 파일
# ==============================

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini


# ==============================
# IDE / 에디터 설정
# 개인별 설정이므로 보통 Git에 올리지 않음
# ==============================

# IntelliJ IDEA
.idea/
*.iml

# VS Code
.vscode/

# Eclipse
.classpath
.project
.settings/


# ==============================
# 로그 파일
# 실행 중 생성되며 소스코드가 아님
# ==============================

*.log
logs/


# ==============================
# 환경변수 / 비밀정보
# API Key, DB 비밀번호 등이 들어갈 수 있음
# 절대 Git에 올리면 안 됨
# ==============================

.env
.env.*
!.env.example


# ==============================
# 빌드 결과물
# 소스코드로 다시 생성 가능하므로 Git에 올리지 않음
# ==============================

build/
dist/
out/
target/


# ==============================
# 임시 파일
# ==============================

*.tmp
*.temp
*.swp